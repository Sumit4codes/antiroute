# AntiRoute Environment Template
# Copy to .env or source directly: source ./export-env.sh [tool]

# Anthropic Endpoint (Claude Code, Cline, OpenCode)
ANTHROPIC_BASE_URL="http://127.0.0.1:8317"
ANTHROPIC_API_KEY="sk-antigravity-claude"

# OpenAI Endpoint (Hermes, OpenCode, Aider, Goose)
OPENAI_BASE_URL="http://127.0.0.1:8317/v1"
OPENAI_API_KEY="sk-antigravity-claude"

# Default Model
MODEL="gemini-3.8-flash-high"
